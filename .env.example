# DMS 首页或登录后的落地页 URL（内部地址，只写在本地 .env，不提交）
DMS_BASE_URL=
# 可选：覆盖 session 文件路径；留空则使用默认路径
DMS_STATE_PATH=
# 可选：覆盖运行数据目录；留空使用 LOCALAPPDATA 下的默认目录
RUNTIME_DATA_DIR=
# 可选：单 Station 路区画像请求上限（含默认加载）；留空使用 3
MAX_PAGE_LOADS_PER_STATION=
MAX_ROUTE_DETAIL_REQUESTS=

# PostgreSQL：只在本地 .env 中填写真实值，不提交；不要输出连接串。
# DATA_SOURCE=json|db；默认 json，db 用 NC_DB_READER_URL 查询只读视图。
DATA_SOURCE=json
# 1 表示开启批处理 JSON / DB 双写；留空沿用 JSON。
DB_DUAL_WRITE=
# 正式库：owner 仅用于 migration；scraper 用于写入；reader 用于只读视图。
NC_DB_OWNER_URL=
NC_DB_SCRAPER_URL=
NC_DB_READER_URL=
# 只给 Worker（3100）使用，不放进 readonly.env。
NC_DB_WAREHOUSE_URL=
# npm run db:import-json：以 scraper 一次性导入本地 JSON，不修改源文件。
# npm run db:parity：以 reader 比较 JSON / DB API 响应，仅本地运行。
# 自动化测试专用 nc_ops_test 数据库，不能指向正式库。
NC_TEST_DB_OWNER_URL=
NC_TEST_DB_SCRAPER_URL=
NC_TEST_DB_READER_URL=
NC_TEST_DB_WAREHOUSE_URL=

# Worker 仅监听 127.0.0.1；默认端口 3100，允许 1–65535。
WORKER_PORT=
# Worker 每日自动刷新：空值或 off 关闭；示例 AUTO_REFRESH_TIME=17:00，仅 DB 模式生效。
AUTO_REFRESH_TIME=
AUTO_REFRESH_TZ=America/Los_Angeles
# 仅用于 readonly.env：IPv4 地址或 localhost，默认 127.0.0.1。
# 局域网监听时必须使用 DB reader，且不能包含 scraper / owner / DMS 配置。
LISTEN_HOST=
